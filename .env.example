# HTTP port (default 3000).
PORT=3000
# SQLite file; defaults to kairos.db beside server.js.
DB_PATH=kairos.db
# Externally reachable HTTPS origin for SMS links and callbacks; local default is printed at startup.
PUBLIC_URL=
# Optional owned wildcard domain, without scheme; requires wildcard DNS and HTTPS reverse proxy.
BASE_DOMAIN=
# Random private bearer token for trusted voice-agent tools. Unset disables tools.
TOOL_TOKEN=
# Random private callback token shared with the providers. Unset disables webhooks.
WEBHOOK_SECRET=
# Android SMS Gateway local-server URL; unset prints simulated messages and OTPs to the console.
SMS_GATEWAY_URL=
# Android gateway HTTP Basic username.
SMS_GATEWAY_USER=
# Android gateway HTTP Basic password.
SMS_GATEWAY_PASS=
# Sarvam API key; unset enables visibly labelled scripted calls.
SARVAM_API_KEY=
# Sarvam organisation identifier.
SARVAM_ORG_ID=
# Sarvam workspace identifier.
SARVAM_WORKSPACE_ID=
# Provisioned telephony connection identifier.
SARVAM_CONNECTION_ID=
# Provisioned agent phone number in international format.
SARVAM_AGENT_NUMBER=
# Deployed supplier voice app, configured with the authenticated tool routes.
SARVAM_SUPPLIER_APP_ID=
# Numeric supplier voice app version.
SARVAM_SUPPLIER_APP_VERSION=
# Maximum total calls per task, including confirmation; integer from 1 to 6.
MAX_ATTEMPTS=6
# Delay before each simulated supplier response, in milliseconds.
SIM_DELAY_MS=1500
# Leave empty for rule-based advice and manual supplier entry; codex enables web research (150s) and advice (90s).
THINKER=
# Demo recipient only; unset uses the clearly fake +910000000000. Never commit a real number.
DEMO_OWNER_PHONE=
# Set to 1 to require an SMS code before a task page opens; default is open links.
REQUIRE_OTP=
# Hours after creation at which a task link stops resolving (default 24).
TASK_TTL_HOURS=24
# Comma-separated Sarvam egress IPs allowed to call /tools without the bearer token (demo shortcut; leave empty to require the token).
SARVAM_IPS=

# Calling window for researched suppliers only, in Asia/Kolkata (equal times allow all day).
RESEARCH_CALL_HOURS=09:00-20:00
# Comma-separated phone numbers exempt from the researched-supplier calling window.
ALLOW_NUMBERS=
# Optional test suppliers used when a caller names none, e.g. "Name, +91XXXXXXXXXX". Leave empty to research suppliers instead. Never commit a real number.
DEMO_SUPPLIERS=

# Deployed owner voice app for result calls; real calls require both owner app settings.
SARVAM_OWNER_APP_ID=
# Numeric owner voice app version.
SARVAM_OWNER_APP_VERSION=
# Delay before calling the owner with offers, allowing advice to arrive first (milliseconds).
OWNER_CALL_DELAY_MS=20000
