# HTTP port (default 3000).
PORT=3000
# SQLite file; defaults to kairos.db beside server.js.
DB_PATH=kairos.db
# Externally reachable HTTPS origin for SMS links and callbacks; local default is printed at startup.
PUBLIC_URL=
# Optional owned wildcard domain, without scheme; requires wildcard DNS and HTTPS reverse proxy.
BASE_DOMAIN=
# Random private bearer token for trusted voice-agent tools. Unset disables tools.
TOOL_TOKEN=
# Random private callback token shared with the providers. Unset disables webhooks.
WEBHOOK_SECRET=
# Android SMS Gateway local-server URL; unset prints simulated messages and OTPs to the console.
SMS_GATEWAY_URL=
# Android gateway HTTP Basic username.
SMS_GATEWAY_USER=
# Android gateway HTTP Basic password.
SMS_GATEWAY_PASS=
# Sarvam API key; unset enables visibly labelled scripted calls.
SARVAM_API_KEY=
# Sarvam organisation identifier.
SARVAM_ORG_ID=
# Sarvam workspace identifier.
SARVAM_WORKSPACE_ID=
# Provisioned telephony connection identifier.
SARVAM_CONNECTION_ID=
# Provisioned agent phone number in international format.
SARVAM_AGENT_NUMBER=
# Deployed supplier voice app, configured with the authenticated tool routes.
SARVAM_SUPPLIER_APP_ID=
# Numeric supplier voice app version.
SARVAM_SUPPLIER_APP_VERSION=
# Maximum total calls per task, including confirmation; integer from 1 to 6.
MAX_ATTEMPTS=6
# Delay before each simulated supplier response, in milliseconds.
SIM_DELAY_MS=1500
# Leave empty for deterministic layout; codex tries a read-only CLI layout with a 60-second timeout.
THINKER=
# Demo recipient only; unset uses the clearly fake +910000000000. Never commit a real number.
DEMO_OWNER_PHONE=
